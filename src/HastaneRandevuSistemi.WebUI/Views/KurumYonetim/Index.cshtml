@model HastaneRandevuSistemi.WebUI.Models.KurumYonetimSayfaViewModel
@using HastaneRandevuSistemi.Core.Enums
@{
    ViewData["Title"] = Model.KapsamBasligi;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h3 class="fw-bold mb-0">@Model.KapsamBasligi</h3>
        @if (Model.SistemYoneticisiMi)
        {
            <small class="text-muted">Genel Merkez Sistem Yöneticisi olarak yeni hastane şubeleri açabilir, şube yöneticileri atayabilir ve tüm şubeleri yönetebilirsiniz.</small>
        }
        else
        {
            <small class="text-primary fw-semibold">
                Yalnızca sorumlu olduğunuz hastane (@Model.Subeler.FirstOrDefault()?.SubeAdi) bünyesindeki poliklinik, hizmet ve çalışanları yönetmektesiniz.
            </small>
        }
    </div>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm">Ana Sayfaya Dön</a>
</div>

@if (TempData["BasariMesaji"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>İşlem Başarılı!</strong> @TempData["BasariMesaji"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["HataMesaji"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Uyarı:</strong> @TempData["HataMesaji"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    @if (Model.SistemYoneticisiMi)
    {
        <!-- Yalnızca Ana Sistem Yöneticisine (Super Admin) Görünen: Yeni Hastane Şubesi ve Şube Yöneticisi Atama -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100 border-top border-danger border-3">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="mb-0">Genel Merkez: Yeni Hastane / Klinik Şubesi Aç</h5>
                </div>
                <div class="card-body">
                    <form asp-action="SubeEkle" method="post">
                        <div class="row g-2 mb-2">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Bağlı Sağlık Kurumu</label>
                                <select name="SaglikKurumuId" class="form-select form-select-sm" required>
                                    @foreach (var kurum in Model.Kurumlar)
                                    {
                                        <option value="@kurum.Id">@kurum.KurumAdi</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Hastane / Klinik Şube Adı</label>
                                <input type="text" name="SubeAdi" class="form-control form-control-sm" placeholder="Örn: Kocaeli Bölge Hastanesi" required />
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Şehir</label>
                                <input type="text" name="Sehir" class="form-control form-control-sm" placeholder="Örn: Kocaeli" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">İlçe</label>
                                <input type="text" name="Ilce" class="form-control form-control-sm" placeholder="Örn: İzmit" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Telefon</label>
                                <input type="text" name="Telefon" class="form-control form-control-sm" placeholder="0262 444 03 03" required />
                            </div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Açık Adres</label>
                                <input type="text" name="Adres" class="form-control form-control-sm" placeholder="Mahalle, Cadde, No..." required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Açılış Saati</label>
                                <input type="time" name="AcilisSaati" class="form-control form-control-sm" value="08:30" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Kapanış Saati</label>
                                <input type="time" name="KapanisSaati" class="form-control form-control-sm" value="18:30" required />
                            </div>
                        </div>

                        <button type="submit" class="btn btn-danger btn-sm w-100 fw-semibold">Yeni Hastane Şubesini Kaydet</button>
                    </form>

                    @if (Model.Subeler.Any())
                    {
                        <hr class="my-3" />
                        <h6 class="fw-bold small text-uppercase text-muted mb-2">Mevcut Hastane / Klinik Şubeleri</h6>
                        <ul class="list-group list-group-flush small">
                            @foreach (var s in Model.Subeler)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-1">
                                    <div>
                                        <span class="fw-semibold">@s.SubeAdi</span>
                                        <span class="text-muted">(@s.Ilce / @s.Sehir)</span>
                                    </div>
                                    <form asp-action="SubeKaldir" method="post" class="d-inline">
                                        <input type="hidden" name="subeId" value="@s.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2">Şubeyi Kaldır</button>
                                    </form>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100 border-top border-primary border-3">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0">Genel Merkez: Hastane Şubesine Yönetici Ata</h5>
                </div>
                <div class="card-body">
                    <form asp-action="SubeYoneticisiEkle" method="post">
                        <div class="row g-2 mb-2">
                            <div class="col-md-12">
                                <label class="form-label small fw-semibold">Sorumlu Olacağı Hastane / Klinik Şubesi</label>
                                <select name="HastaneSubeId" class="form-select form-select-sm" required>
                                    @foreach (var s in Model.Subeler)
                                    {
                                        <option value="@s.Id">@s.SubeAdi (@s.Sehir)</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Yönetici Adı</label>
                                <input type="text" name="Ad" class="form-control form-control-sm" placeholder="Ad" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Yönetici Soyadı</label>
                                <input type="text" name="Soyad" class="form-control form-control-sm" placeholder="Soyad" required />
                            </div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-md-5">
                                <label class="form-label small fw-semibold">Kurumsal E-Posta (Giriş İçin)</label>
                                <input type="email" name="Email" class="form-control form-control-sm" placeholder="yonetici@marmaramedikal.com" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Telefon</label>
                                <input type="text" name="Telefon" class="form-control form-control-sm" placeholder="0532 XXX XX XX" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Giriş Şifresi</label>
                                <input type="text" name="Sifre" class="form-control form-control-sm" value="123456" required />
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary btn-sm w-100 fw-semibold">Şube Yöneticisini Kaydet ve Ata</button>
                    </form>

                    @if (Model.SubeYoneticileri.Any())
                    {
                        <hr class="my-3" />
                        <h6 class="fw-bold small text-uppercase text-muted mb-2">Atanmış Şube Yöneticileri ve Yetki Kaldırma</h6>
                        <ul class="list-group list-group-flush small">
                            @foreach (var y in Model.SubeYoneticileri)
                            {
                                var atananSubeAdi = Model.Subeler.FirstOrDefault(s => s.Id == y.SorumluSubeId)?.SubeAdi ?? y.YetkiUnvani;
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-1">
                                    <div>
                                        <span class="fw-semibold">@y.TamAd</span>
                                        <span class="badge bg-primary-subtle text-primary ms-1">@atananSubeAdi</span>
                                        <br />
                                        <small class="text-muted">@y.Email</small>
                                    </div>
                                    <form asp-action="SubeYoneticisiYetkiKaldir" method="post" class="d-inline">
                                        <input type="hidden" name="yoneticiId" value="@y.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2">Yetkiyi Kaldır</button>
                                    </form>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Poliklinik (Bölüm) ve Sağlık Hizmeti Tanımlama -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-success text-white py-3">
                <h5 class="mb-0">Poliklinik (Bölüm) ve Sağlık Hizmeti Tanımlama</h5>
            </div>
            <div class="card-body">
                <form asp-action="DepartmanEkle" method="post" class="border-bottom pb-3 mb-3">
                    <h6 class="fw-bold text-success mb-2">A) Hastaneye Yeni Poliklinik / Bölüm Ekle</h6>
                    <div class="row g-2">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold mb-1">Hastane Şubesi</label>
                            <select name="HastaneSubeId" class="form-select form-select-sm" required>
                                @foreach (var s in Model.Subeler)
                                {
                                    <option value="@s.Id">@s.SubeAdi</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold mb-1">Poliklinik / Bölüm Adı</label>
                            <input type="text" name="DepartmanAdi" class="form-control form-control-sm" placeholder="Örn: Göz Hastalıkları" required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-semibold mb-1">Kat / Blok</label>
                            <input type="text" name="KatBilgisi" class="form-control form-control-sm" placeholder="Örn: 2. Kat" required />
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <input type="hidden" name="Aciklama" value="Poliklinik tanı ve tedavi birimi" />
                            <button type="submit" class="btn btn-outline-success btn-sm w-100">Ekle</button>
                        </div>
                    </div>
                </form>

                <form asp-action="HizmetEkle" method="post">
                    <h6 class="fw-bold text-success mb-2">B) Polikliniğe Yeni Sağlık Hizmeti (Süre ve Ücret) Tanımla</h6>
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold mb-1">Bağlı Poliklinik / Bölüm</label>
                            <select name="DepartmanId" class="form-select form-select-sm" required>
                                @foreach (var d in Model.Departmanlar)
                                {
                                    <option value="@d.Id">@d.DepartmanAdi (@d.HastaneSube?.SubeAdi)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold mb-1">Hizmet Kategorisi</label>
                            <select name="HizmetTipi" class="form-select form-select-sm" required>
                                @foreach (var tip in Enum.GetValues<HizmetTipi>())
                                {
                                    <option value="@tip">@tip</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold mb-1">Hizmet / İşlem Adı</label>
                            <input type="text" name="HizmetAdi" class="form-control form-control-sm" placeholder="Örn: Detaylı Göz Muayenesi" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold mb-1">İşlem Süresi (Dakika)</label>
                            <input type="number" name="SureDakika" class="form-control form-control-sm" placeholder="Örn: 30" min="5" max="240" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold mb-1">Temel Ücret (₺)</label>
                            <input type="number" step="0.01" name="TemelUcret" class="form-control form-control-sm" placeholder="Örn: 1500" min="0" required />
                        </div>
                    </div>
                    <input type="hidden" name="Aciklama" value="Kurumsal sağlık hizmeti" />
                    <button type="submit" class="btn btn-success btn-sm w-100 fw-semibold">Sağlık Hizmetini Kaydet</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Doktor Kaydı ve Doktora Ek Hizmet Tanımlama -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-info text-dark py-3">
                <h5 class="mb-0 fw-bold">Doktor Kaydı ve Sunduğu Hizmetleri Eşleştirme</h5>
            </div>
            <div class="card-body">
                <form asp-action="DoktorEkle" method="post" class="border-bottom pb-3 mb-3">
                    <h6 class="fw-bold mb-2">A) Hastaneye Yeni Doktor Kaydet</h6>
                    <div class="row g-2 mb-2">
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold mb-1">Unvan</label>
                            <select name="Unvan" class="form-select form-select-sm">
                                <option value="Prof. Dr.">Prof. Dr.</option>
                                <option value="Doç. Dr.">Doç. Dr.</option>
                                <option value="Uzm. Dr." selected>Uzm. Dr.</option>
                                <option value="Op. Dr.">Op. Dr.</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold mb-1">Ad</label>
                            <input type="text" name="Ad" class="form-control form-control-sm" placeholder="Doktor Adı" required />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label small fw-semibold mb-1">Soyad</label>
                            <input type="text" name="Soyad" class="form-control form-control-sm" placeholder="Doktor Soyadı" required />
                        </div>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold mb-1">Uzmanlık Alanı</label>
                            <input type="text" name="UzmanlikAlani" class="form-control form-control-sm" placeholder="Örn: Kardiyoloji Uzmanı" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold mb-1">Kurum Sicil No</label>
                            <input type="text" name="SicilNo" class="form-control form-control-sm" placeholder="Örn: DR-5409" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold mb-1">Diploma No</label>
                            <input type="text" name="DiplomaNo" class="form-control form-control-sm" placeholder="Örn: DIP-2020" required />
                        </div>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold mb-1">Görev Yapacağı Poliklinik</label>
                            <select name="DepartmanId" class="form-select form-select-sm" required>
                                @foreach (var d in Model.Departmanlar)
                                {
                                    <option value="@d.Id">@d.DepartmanAdi (@d.HastaneSube?.SubeAdi)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold mb-1">Vereceği Ana Sağlık Hizmeti</label>
                            <select name="SaglikHizmetiId" class="form-select form-select-sm" required>
                                @foreach (var h in Model.Hizmetler)
                                {
                                    <option value="@h.Id">@h.HizmetAdi (@h.Departman?.DepartmanAdi)</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold mb-1">Doktor Ek Fark Ücreti (₺)</label>
                            <input type="number" step="50" name="OzelUcretFarki" class="form-control form-control-sm" placeholder="Ek ücret (Yoksa 0)" min="0" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold mb-1">Kurumsal E-Posta</label>
                            <input type="email" name="Email" class="form-control form-control-sm" placeholder="ad.soyad@marmaramedikal.com" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold mb-1">Telefon</label>
                            <input type="text" name="Telefon" class="form-control form-control-sm" placeholder="0532 XXX XX XX" required />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-info btn-sm w-100 fw-semibold">Yeni Doktoru Kaydet</button>
                </form>

                <!-- Madde 3 Düzeltmesi: Açıklayıcı Etiketler ve Placeholder -->
                <form asp-action="DoktoraHizmetEkle" method="post">
                    <h6 class="fw-bold mb-2">B) Mevcut Doktora Ek Sağlık Hizmeti Eşleştir</h6>
                    <div class="row g-2 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold mb-1">Doktor Seçimi</label>
                            <select name="DoktorId" class="form-select form-select-sm" required>
                                @foreach (var d in Model.Doktorlar)
                                {
                                    <option value="@d.Id">@d.Unvan @d.TamAd (@d.Departman?.DepartmanAdi)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold mb-1">Tanımlanacak Sağlık Hizmeti</label>
                            <select name="SaglikHizmetiId" class="form-select form-select-sm" required>
                                @foreach (var h in Model.Hizmetler)
                                {
                                    <option value="@h.Id">@h.HizmetAdi (@h.TemelUcret.ToString("N0") ₺)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold mb-1">Doktor Ek Fark Ücreti (₺)</label>
                            <div class="input-group input-group-sm">
                                <input type="number" step="50" name="OzelUcretFarki" class="form-control"
                                       placeholder="Ek ücret (₺) - Yoksa 0" min="0" required />
                                <button type="submit" class="btn btn-dark">Eşleştir</button>
                            </div>
                        </div>
                    </div>
                    <small class="text-muted d-block mt-1">
                        * <strong>Doktor Ek Fark Ücreti (₺):</strong> Hizmetin temel ücretine ek olarak doktorun unvan/uzmanlık farkı varsa giriniz (Ek fark yoksa <code>0</code> yazınız).
                    </small>
                </form>
            </div>
        </div>
    </div>

    <!-- Doktor Uygunluk Zaman Dilimi Tanımlama -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-dark text-white py-3">
                <h5 class="mb-0">Doktor Poliklinik Çalışma Saatleri ve Uygunluk Takvimi</h5>
            </div>
            <div class="card-body">
                <form asp-action="UygunlukTanimla" method="post">
                    <div class="row g-2 mb-2">
                        <div class="col-md-7">
                            <label class="form-label small fw-semibold">Doktor Seçimi</label>
                            <select name="DoktorId" class="form-select form-select-sm" required>
                                @foreach (var d in Model.Doktorlar)
                                {
                                    <option value="@d.Id">@d.Unvan @d.TamAd (@d.HastaneSube?.SubeAdi)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label small fw-semibold">Çalışma Günü</label>
                            <select name="Gun" class="form-select form-select-sm" required>
                                <option value="Monday">Pazartesi</option>
                                <option value="Tuesday">Salı</option>
                                <option value="Wednesday">Çarşamba</option>
                                <option value="Thursday">Perşembe</option>
                                <option value="Friday">Cuma</option>
                                <option value="Saturday">Cumartesi</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">Mesai Başlangıç</label>
                            <input type="time" name="BaslangicSaati" class="form-control form-control-sm" value="09:00" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">Mesai Bitiş</label>
                            <input type="time" name="BitisSaati" class="form-control form-control-sm" value="17:30" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">Öğle Arası Başlangıç</label>
                            <input type="time" name="MolaBaslangic" class="form-control form-control-sm" value="12:30" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">Öğle Arası Bitiş</label>
                            <input type="time" name="MolaBitis" class="form-control form-control-sm" value="13:30" />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-dark btn-sm w-100 fw-semibold">Çalışma Saatlerini Kaydet / Güncelle</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Sağlık Personeli Kaydı -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-secondary text-white py-3">
                <h5 class="mb-0">Sağlık Personeli Kaydı (Hemşire / Teknisyen)</h5>
            </div>
            <div class="card-body">
                <form asp-action="SaglikPersoneliEkle" method="post">
                    <div class="row g-2 mb-2">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Görev Unvanı</label>
                            <select name="Unvan" class="form-select form-select-sm">
                                <option value="Hemşire">Hemşire</option>
                                <option value="Başhemşire">Başhemşire</option>
                                <option value="Radyoloji Teknisyeni">Radyoloji Teknisyeni</option>
                                <option value="Laboratuvar Teknikeri">Laboratuvar Teknikeri</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Ad</label>
                            <input type="text" name="Ad" class="form-control form-control-sm" placeholder="Personel Adı" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Soyad</label>
                            <input type="text" name="Soyad" class="form-control form-control-sm" placeholder="Personel Soyadı" required />
                        </div>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Görev Yaptığı Poliklinik</label>
                            <select name="DepartmanId" class="form-select form-select-sm" required>
                                @foreach (var d in Model.Departmanlar)
                                {
                                    <option value="@d.Id">@d.DepartmanAdi (@d.HastaneSube?.SubeAdi)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Görev Tanımı</label>
                            <input type="text" name="GorevAlani" class="form-control form-control-sm" placeholder="Örn: Hasta Kabul & EKG Hazırlık" required />
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Sicil No</label>
                            <input type="text" name="SicilNo" class="form-control form-control-sm" placeholder="Örn: SP-205" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Çalışma Vardiyası</label>
                            <input type="text" name="VardiyaBilgisi" class="form-control form-control-sm" placeholder="Örn: 08:00 - 17:00" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Kurumsal E-Posta</label>
                            <input type="email" name="Email" class="form-control form-control-sm" placeholder="personel@marmaramedikal.com" required />
                            <input type="hidden" name="Telefon" value="0532 700 70 70" />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-secondary btn-sm w-100 fw-semibold">Sağlık Personelini Kaydet</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Mevcut Poliklinikler, Hizmetler, Doktorlar ve Personel Yetki/Kayıt Kaldırma Paneli -->
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-0 fw-bold">Kayıtlı Poliklinikler, Hizmetler ve Çalışan Yetkilerini Yönet / Kaldır</h5>
                    <small class="text-muted">Tanımladığınız bölümleri, sağlık hizmetlerini, doktor-hizmet eşleştirmelerini veya çalışan yetkilerini buradan kaldırabilirsiniz.</small>
                </div>
            </div>
            <div class="card-body">
                <div class="row g-4">
                    <!-- Sol: Poliklinikler ve Sağlık Hizmetleri -->
                    <div class="col-lg-5">
                        <h6 class="fw-bold text-success border-bottom pb-2 mb-3">Poliklinikler ve Tanımlı Sağlık Hizmetleri</h6>
                        @if (!Model.Departmanlar.Any())
                        {
                            <div class="text-muted small fst-italic">Kayıtlı poliklinik bulunmamaktadır.</div>
                        }
                        @foreach (var dep in Model.Departmanlar)
                        {
                            var depHizmetleri = Model.Hizmetler.Where(h => h.DepartmanId == dep.Id).ToList();
                            <div class="border rounded p-2 mb-2 bg-light">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <div>
                                        <span class="fw-bold text-dark">@dep.DepartmanAdi</span>
                                        <small class="text-muted">(@dep.HastaneSube?.SubeAdi - @dep.KatBilgisi)</small>
                                    </div>
                                    <form asp-action="DepartmanKaldir" method="post" class="d-inline">
                                        <input type="hidden" name="departmanId" value="@dep.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2">Bölümü Kaldır</button>
                                    </form>
                                </div>
                                @if (depHizmetleri.Any())
                                {
                                    <ul class="list-group list-group-flush small mt-1">
                                        @foreach (var h in depHizmetleri)
                                        {
                                            <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent px-1 py-1">
                                                <span>@h.HizmetAdi (@h.SureDakika dk - @h.TemelUcret.ToString("N0") ₺)</span>
                                                <form asp-action="HizmetKaldir" method="post" class="d-inline">
                                                    <input type="hidden" name="hizmetId" value="@h.Id" />
                                                    <button type="submit" class="btn btn-link text-danger btn-sm p-0 text-decoration-none">Hizmeti Kaldır</button>
                                                </form>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                        }
                    </div>

                    <!-- Sağ: Doktorlar, Hizmet Eşleştirmeleri ve Sağlık Personelleri -->
                    <div class="col-lg-7">
                        <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">Hekimlerimiz ve Hizmet Eşleştirmeleri</h6>
                        <div class="table-responsive mb-4">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Hekim</th>
                                        <th>Poliklinik / Şube</th>
                                        <th>Eşleştirilen Sağlık Hizmetleri</th>
                                        <th class="text-end">İşlem</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var dr in Model.Doktorlar)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@dr.Unvan @dr.TamAd<br /><small class="text-muted">@dr.UzmanlikAlani</small></td>
                                            <td class="small">@dr.Departman?.DepartmanAdi<br /><span class="text-muted">@dr.HastaneSube?.SubeAdi</span></td>
                                            <td>
                                                @foreach (var dh in dr.DoktorHizmetleri)
                                                {
                                                    <span class="badge bg-info-subtle text-dark border d-inline-flex align-items-center gap-1 me-1 mb-1">
                                                        @dh.SaglikHizmeti?.HizmetAdi @(dh.OzelUcretFarki > 0 ? $"(+{dh.OzelUcretFarki:N0}₺)" : "")
                                                        <form asp-action="DoktorHizmetKaldir" method="post" class="d-inline">
                                                            <input type="hidden" name="doktorHizmetId" value="@dh.Id" />
                                                            <button type="submit" class="btn btn-sm p-0 border-0 text-danger fw-bold ms-1" title="Bu hizmet eşleştirmesini kaldır">×</button>
                                                        </form>
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <form asp-action="DoktorKaldir" method="post" class="d-inline">
                                                    <input type="hidden" name="doktorId" value="@dr.Id" />
                                                    <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2">Kaydı Kaldır</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <h6 class="fw-bold text-secondary border-bottom pb-2 mb-2">Kayıtlı Sağlık Personelleri</h6>
                        @if (!Model.SaglikPersonelleri.Any())
                        {
                            <div class="text-muted small fst-italic">Kayıtlı sağlık personeli bulunmamaktadır.</div>
                        }
                        else
                        {
                            <ul class="list-group list-group-flush small">
                                @foreach (var sp in Model.SaglikPersonelleri)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-1">
                                        <div>
                                            <span class="fw-semibold">@sp.Unvan @sp.TamAd</span> - @sp.GorevAlani
                                            <span class="text-muted">(@sp.Departman?.DepartmanAdi / @sp.HastaneSube?.SubeAdi)</span>
                                        </div>
                                        <form asp-action="SaglikPersoneliKaldir" method="post" class="d-inline">
                                            <input type="hidden" name="personelId" value="@sp.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2">Personeli Kaldır</button>
                                        </form>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
