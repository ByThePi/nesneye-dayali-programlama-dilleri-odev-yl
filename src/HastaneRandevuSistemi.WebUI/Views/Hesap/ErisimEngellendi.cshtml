@{
    ViewData["Title"] = "Erişim Engellendi";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm text-center p-4">
            <div class="card-body">
                <h2 class="text-danger fw-bold mb-3">Bu Sayfaya Erişim Yetkiniz Yok</h2>
                <p class="text-muted mb-4">
                    Görüntülemeye çalıştığınız yönetim sayfası yalnızca yetkili <strong>Hastane / Klinik Yöneticileri</strong> ve <strong>Sistem Yöneticisi</strong> içindir.
                </p>
                <div class="d-flex justify-content-center gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Ana Menüye Dön</a>
                    <a asp-controller="Randevu" asp-action="Index" class="btn btn-outline-secondary">Randevu Ekranına Git</a>
                </div>
            </div>
        </div>
    </div>
</div>
