@model HastaneRandevuSistemi.WebUI.Models.DashboardViewModel
@using HastaneRandevuSistemi.Core.Enums
@{
    ViewData["Title"] = "Hastanelerimiz ve Hekimlerimiz";
    bool yoneticiMi = User.IsInRole("SistemYoneticisi") || User.IsInRole("KurumYoneticisi");
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h2 class="fw-bold mb-1">Hoş Geldiniz, @Model.AktifKullanici?.TamAd</h2>
        @if (!string.IsNullOrWhiteSpace(Model.SorumluSubeAdi))
        {
            <p class="text-primary fw-semibold mb-0">Yetkili Olduğunuz Kurum: @Model.SorumluSubeAdi</p>
        }
        else
        {
            <p class="text-muted mb-0">Hastane ve kliniğimizdeki poliklinikleri, uzman hekim kadromuzu ve çalışma saatlerini inceleyebilirsiniz.</p>
        }
    </div>
    <div class="d-flex gap-2">
        @if (yoneticiMi)
        {
            <a asp-controller="KurumYonetim" asp-action="Index" class="btn btn-outline-primary fw-semibold">
                Hastane Yönetim Paneli
            </a>
        }
        <a asp-controller="Randevu" asp-action="Index" class="btn btn-primary fw-semibold">
            Randevu Al / Randevularım
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted text-uppercase small">Hizmet Veren Hastane / Klinik</h6>
                <h3 class="fw-bold text-primary mb-0">@Model.Subeler.Count</h3>
                <small class="text-secondary">Aktif sağlık merkezi</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted text-uppercase small">Tıbbi İşlem &amp; Muayene</h6>
                <h3 class="fw-bold text-success mb-0">@Model.Hizmetler.Count</h3>
                <small class="text-secondary">Poliklinik ve görüntüleme hizmeti</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted text-uppercase small">Uzman Hekim Kadromuz</h6>
                <h3 class="fw-bold text-info mb-0">@Model.Doktorlar.Count</h3>
                <small class="text-secondary">Aktif görev yapan doktor</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted text-uppercase small">Kayıtlı Randevular</h6>
                <h3 class="fw-bold text-warning mb-0">@Model.Randevular.Count</h3>
                <small class="text-secondary">Planlanan muayene ve işlemler</small>
            </div>
        </div>
    </div>
</div>

<!-- Hastane, Poliklinik (Bölüm) ve Hekim Filtreleme Çubuğu -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body py-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1">Hastane / Klinik Şubesi</label>
                <select name="subeId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">Tüm Hastane ve Klinikler</option>
                    @foreach (var s in Model.TumSubeler)
                    {
                        if (Model.SeciliSubeId == s.Id)
                        {
                            <option value="@s.Id" selected>@s.SubeAdi (@s.Sehir)</option>
                        }
                        else
                        {
                            <option value="@s.Id">@s.SubeAdi (@s.Sehir)</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1">Poliklinik / Bölüm</label>
                <select name="departmanId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">Tüm Poliklinikler / Bölümler</option>
                    @foreach (var dep in Model.TumDepartmanlar.Where(d => !Model.SeciliSubeId.HasValue || d.HastaneSubeId == Model.SeciliSubeId.Value))
                    {
                        if (Model.SeciliDepartmanId == dep.Id)
                        {
                            <option value="@dep.Id" selected>@dep.DepartmanAdi (@dep.HastaneSube?.SubeAdi)</option>
                        }
                        else
                        {
                            <option value="@dep.Id">@dep.DepartmanAdi (@dep.HastaneSube?.SubeAdi)</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1">Hekim Seçimi</label>
                <select name="doktorId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">Tüm Hekimlerimiz</option>
                    @foreach (var dr in Model.TumDoktorlar.Where(d => (!Model.SeciliSubeId.HasValue || d.HastaneSubeId == Model.SeciliSubeId.Value) && (!Model.SeciliDepartmanId.HasValue || d.DepartmanId == Model.SeciliDepartmanId.Value)))
                    {
                        if (Model.SeciliDoktorId == dr.Id)
                        {
                            <option value="@dr.Id" selected>@dr.Unvan @dr.TamAd (@dr.Departman?.DepartmanAdi)</option>
                        }
                        else
                        {
                            <option value="@dr.Id">@dr.Unvan @dr.TamAd (@dr.Departman?.DepartmanAdi)</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1">Hızlı Arama</label>
                <div class="input-group input-group-sm">
                    <input type="text" name="arama" value="@Model.AramaMetni" class="form-control" placeholder="Bölüm, işlem veya hekim ara..." />
                    <button type="submit" class="btn btn-primary">Filtrele</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Sıfırla</a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- 1. Hastane / Klinik Şubelerimiz, Poliklinikler ve Hizmetlerimiz -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold">Hastanelerimiz, Poliklinikler ve Sunulan Sağlık Hizmetleri</h5>
        <span class="badge bg-light text-dark border">@Model.Subeler.Count şube görüntüleniyor</span>
    </div>
    <div class="card-body">
        <div class="row g-4">
            @if (!Model.Subeler.Any())
            {
                <div class="col-12">
                    <div class="alert alert-warning mb-0">Seçilen filtre kriterlerine uygun hastane veya poliklinik bulunamadı.</div>
                </div>
            }
            @foreach (var sube in Model.Subeler)
            {
                var gosterilecekDepartmanlar = sube.Departmanlar
                    .Where(dep => !Model.SeciliDepartmanId.HasValue || dep.Id == Model.SeciliDepartmanId.Value)
                    .ToList();

                <div class="col-md-6">
                    <div class="border rounded p-3 h-100 bg-light">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <span class="badge bg-primary mb-1">@sube.SaglikKurumu?.KurumAdi</span>
                                <h5 class="fw-bold mb-0">@sube.SubeAdi</h5>
                                <small class="text-muted">@sube.Adres (@sube.Ilce / @sube.Sehir) | Tel: @sube.Telefon</small>
                            </div>
                            <span class="badge bg-dark">
                                Çalışma Saatleri: @sube.AcilisSaati.ToString(@"hh\:mm") - @sube.KapanisSaati.ToString(@"hh\:mm")
                            </span>
                        </div>
                        <hr />
                        @if (!gosterilecekDepartmanlar.Any())
                        {
                            <div class="text-muted small fst-italic">
                                Bu şubeye henüz poliklinik eklenmemiştir.
                            </div>
                        }
                        @foreach (var dep in gosterilecekDepartmanlar)
                        {
                            <div class="mb-3">
                                <div class="fw-semibold text-primary">@dep.DepartmanAdi <small class="text-muted">(@dep.KatBilgisi)</small></div>
                                <ul class="list-group list-group-flush mt-1">
                                    @foreach (var hizmet in dep.Hizmetler)
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent px-0 py-1">
                                            <span>@hizmet.HizmetAdi <span class="badge bg-secondary ms-1">@hizmet.SureDakika dk</span></span>
                                            <span class="fw-bold text-success">@hizmet.TemelUcret.ToString("N2") ₺</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- 2. Hekim Kadromuz ve Çalışma Saatleri -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold">Hekim Kadromuz, Uzmanlık Alanları ve Çalışma Saatleri</h5>
        <a asp-controller="Randevu" asp-action="Index" class="btn btn-sm btn-outline-primary">Hemen Randevu Al</a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Hekim</th>
                        <th>Hastane / Poliklinik</th>
                        <th>Uzmanlık Alanı</th>
                        <th>Uyguladığı İşlemler ve Muayeneler</th>
                        <th>Poliklinik Kabul Saatleri</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dr in Model.Doktorlar)
                    {
                        var ornekUygunluk = dr.UygunlukTakvimi.FirstOrDefault();
                        <tr>
                            <td class="fw-semibold">@dr.Unvan @dr.TamAd</td>
                            <td>@dr.HastaneSube?.SubeAdi <br /><small class="text-primary">@dr.Departman?.DepartmanAdi</small></td>
                            <td>@dr.UzmanlikAlani</td>
                            <td>
                                @foreach (var dh in dr.DoktorHizmetleri)
                                {
                                    <span class="badge bg-info text-dark me-1">
                                        @dh.SaglikHizmeti?.HizmetAdi
                                        @(dh.OzelUcretFarki > 0 ? $"(+{dh.OzelUcretFarki:N0} ₺ Dr. Farkı)" : "")
                                    </span>
                                }
                            </td>
                            <td>
                                @if (ornekUygunluk != null)
                                {
                                    <span class="badge bg-success">
                                        Hafta İçi: @ornekUygunluk.BaslangicSaati.ToString(@"hh\:mm") - @ornekUygunluk.BitisSaati.ToString(@"hh\:mm")
                                    </span>
                                    @if (ornekUygunluk.MolaBaslangic.HasValue)
                                    {
                                        <br />
                                        <small class="text-muted">Öğle Arası: @ornekUygunluk.MolaBaslangic.Value.ToString(@"hh\:mm") - @ornekUygunluk.MolaBitis!.Value.ToString(@"hh\:mm")</small>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
